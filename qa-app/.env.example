# ---- Innovate Assure settings (copy to .env) ----
# Password the team types to open the app. Set this!
APP_PASSWORD=choose-a-password

# cowork = no API key: a Claude Cowork scheduled task does the analysis (see cowork/README.md)
# api    = Assure calls Claude directly and needs ANTHROPIC_API_KEY below
ANALYSIS_MODE=cowork
ANTHROPIC_API_KEY=

# Where calls, recordings and reports are stored. Leave blank for qa-app/data, or point at a OneDrive folder.
# DATA_DIR=C:\Users\you\OneDrive\Assure

# Scorecards switched on. Netstar only for now; ns,ct brings Cartrack back.
ENABLED_PRODUCTS=ns

# Speech to text: whisper (built in, free, audio stays on this PC) | deepgram | assemblyai | elevenlabs
TRANSCRIBER=whisper
# WHISPER_MODEL=large-v3-turbo
# WHISPER_BEAM=5
# only the one you use:
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
# RETAIN_AUDIO=true
# MASK_PII=true
